{
  "name": "Paper Library Reader",
  "short_name": "Paper Library",
  "id": "paper-library-reader",
  "description": "Read EPUB, DRM-free MOBI, and PDF books in a paper-style viewer.",
  "start_url": "./#/library",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "lang": "en",
  "categories": ["books", "education"],
  "background_color": "#f2ede3",
  "theme_color": "#28241f",
  "icons": [
    {
      "src": "assets/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "assets/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ]
}
